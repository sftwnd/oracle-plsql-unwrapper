create or replace procedure p_sh sharing = metadata timestamp '2000-01-01:00:00:00' IS
BEGIN
  NULL;
END;
/
create or replace package pkg_sh sharing=none
  timestamp old IS
  X NUMBER;
END;
/
create or replace function f_sh SHARING = OBJECT timestamp old RETURN NUMBER IS
BEGIN
  RETURN 1;
END;
/
create or replace type obj_sh sharing = metadata timestamp '2000-01-01:00:00:00' oid '0123456789ABCDEF0123456789ABCD05' AS OBJECT (A NUMBER);
/
