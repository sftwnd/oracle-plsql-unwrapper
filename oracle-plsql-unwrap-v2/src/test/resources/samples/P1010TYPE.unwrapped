create type app.obj_both
 TIMESTAMP '2001-07-29:12:06:07'
 OID '8A3DB78598BD5DE2E034080020EDC61B'
 AS OBJECT (ID NUMBER, MEMBER FUNCTION F RETURN NUMBER);
/
create or replace type body app.obj_both AS
  MEMBER FUNCTION F RETURN NUMBER IS
  BEGIN
    RETURN ID;
  END;
END;
/
create type obj_line timestamp '2002-10-23:15:30:00' oid '00000000000000000000000000021010'
AS OBJECT (ID NUMBER, NAME VARCHAR2(10));
/
