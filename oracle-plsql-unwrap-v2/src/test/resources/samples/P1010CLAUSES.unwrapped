create or replace procedure app.p_ts timestamp '2000-01-01:00:00:00' IS
BEGIN
  NULL;
END;
/
create or replace function f_both
  timestamp '2000-01-01:00:00:00'
  oid '0123456789ABCDEF0123456789ABCD01'
RETURN NUMBER IS
BEGIN
  RETURN 1;
END;
/
create or replace package pkg_old timestamp old IS
  X NUMBER;
END;
/
create or replace package body pkg_old /* c */ timestamp '2000-01-01:00:00:00'	IS
END;
/
create or replace type obj_old timestamp old oid '0123456789ABCDEF0123456789ABCD02'
  AS OBJECT (A NUMBER, MEMBER PROCEDURE M);
/
create or replace type body obj_old timestamp old IS
  MEMBER PROCEDURE M IS BEGIN NULL; END;
END;
/
create or replace library lib_oid oid '0123456789ABCDEF0123456789ABCD03' AS '/tmp/x.so';
/
create or replace procedure p_oid
oid '0123456789ABCDEF0123456789ABCD04'
IS
BEGIN
  NULL;
END;
/
grant execute on p_oid to public;
