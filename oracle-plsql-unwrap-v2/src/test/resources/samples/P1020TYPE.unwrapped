create type app.obj_both timestamp '2001-07-29:12:06:07' oid '8A3DB78598BD5DE2E034080020EDC61B' AS OBJECT (
    ID NUMBER,
    NAME VARCHAR2(30),
    MEMBER FUNCTION TWICE RETURN NUMBER
);
/
CREATE OR REPLACE TYPE BODY app.obj_both AS
    MEMBER FUNCTION TWICE RETURN NUMBER IS
    BEGIN
        RETURN ID * 2;
    END;
END;
/
GRANT EXECUTE ON app.obj_both TO PUBLIC;
