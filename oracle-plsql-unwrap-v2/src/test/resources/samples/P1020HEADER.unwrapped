create or replace procedure Demo_Proc(P_IN IN VARCHAR2, P_OUT OUT NUMBER) AUTHID CURRENT_USER IS
  

  V_TEXT VARCHAR2(100) := 'Mixed Case ''quoted'' text'; 
  "QuotedName" NUMBER := 1;
  V_Q VARCHAR2(20) := q'[It's q-literal]';
  V_NL VARCHAR2(20) := 'line one
line two';
BEGIN
  SELECT /*+ index(t) */ COUNT(*) INTO P_OUT FROM DUAL T WHERE 'a' = 'A';
  IF P_IN IS NULL THEN
    P_OUT := "QuotedName";
  END IF;
END DEMO_PROC;
/
create   or  replace   procedure   App.Sch_Proc   (P NUMBER) IS
BEGIN
  NULL;
END;
