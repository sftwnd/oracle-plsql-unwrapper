CREATE PROCEDURE no_replace IS
BEGIN
  NULL;
END;
/
create or replace procedure "Quoted Name" IS BEGIN NULL; END;
/
create or replace procedure "APP"."Quoted_Sch" IS BEGIN NULL; END;
/
create or replace
function
Multi_Line RETURN NUMBER IS
BEGIN
  RETURN 1;
END MULTI_LINE;
/
create or replace package App_Pkg AUTHID DEFINER AS
  PROCEDURE P;
  FUNCTION F RETURN NUMBER;
END APP_PKG;
/
create or replace package body App_Pkg  IS
  PROCEDURE P IS BEGIN NULL; END;
  FUNCTION F RETURN NUMBER IS BEGIN RETURN 1; END;
END APP_PKG;
/
create or replace type App_Obj AS OBJECT (
  A NUMBER,
  MEMBER PROCEDURE M
);
/
create or replace type body App_Obj
AS
  MEMBER PROCEDURE M IS BEGIN NULL; END;
END;
/
create or replace library App_Lib AS '/opt/app/lib/app.so';
/
create or replace type App_Tab as table of number;
/
