<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.sftwnd</groupId>
        <artifactId>oracle-plsql-unwrapper-parent</artifactId>
        <version>1.0.2-SNAPSHOT</version>
    </parent>

    <artifactId>oracle-plsql-unwrap-v2</artifactId>

    <name>Oracle PL/SQL Unwrap: format V2</name>
    <description>Implementation of the Oracle wrapped format V2 (Oracle 10g and later)</description>

    <properties>
        <module.name>com.github.sftwnd.oracle.unwrap.v2</module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>oracle-plsql-unwrap-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>oracle-plsql-unwrap-spi</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <instructions>
                        <Export-Package/>
                        <Private-Package>com.github.sftwnd.oracle.unwrap.v2</Private-Package>
                        <Require-Capability>osgi.extender;filter:="(osgi.extender=osgi.serviceloader.registrar)"</Require-Capability>
                        <Provide-Capability>osgi.serviceloader;osgi.serviceloader=com.github.sftwnd.oracle.unwrap.spi.FormatUnwrapper</Provide-Capability>
                    </instructions>
                </configuration>
            </plugin>
            <!-- The test jar holds the samples of V2 that the tests of the unwrapper use -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
