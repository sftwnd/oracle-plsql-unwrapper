<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.sftwnd</groupId>
        <artifactId>oracle-plsql-unwrapper-parent</artifactId>
        <version>1.0.2-SNAPSHOT</version>
    </parent>

    <artifactId>oracle-plsql-unwrapper</artifactId>

    <name>Oracle PL/SQL Unwrap: unwrapper V2</name>
    <description>Unwrapper API and command line; it finds the formats through the SPI and comes with the format V2 only</description>

    <properties>
        <native.skip>false</native.skip>
        <module.name>com.github.sftwnd.oracle.unwrap</module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>oracle-plsql-unwrap-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Found at run time through the SPI; the code does not refer to it -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>oracle-plsql-unwrap-v2</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>oracle-plsql-unwrap-spi</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>oracle-plsql-unwrap-v2</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <instructions>
                        <Export-Package>com.github.sftwnd.oracle.unwrap</Export-Package>
                        <Private-Package>com.github.sftwnd.oracle.unwrap.cli</Private-Package>
                        <Main-Class>com.github.sftwnd.oracle.unwrap.cli.UnwrapperCli</Main-Class>
                        <Require-Capability>osgi.extender;filter:="(osgi.extender=osgi.serviceloader.processor)",osgi.serviceloader;filter:="(osgi.serviceloader=com.github.sftwnd.oracle.unwrap.spi.FormatUnwrapper)";cardinality:=multiple</Require-Capability>
                    </instructions>
                </configuration>
            </plugin>
            <!-- The test jar holds the launch test that the module oracle-plsql-unwrapper-pro reuses -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                        </manifest>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>${jacoco-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>report-aggregate</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report-aggregate</goal>
                                </goals>
                                <configuration>
                                    <includeCurrentProject>true</includeCurrentProject>
                                    <excludes>
                                        <exclude>META-INF/versions/**</exclude>
                                    </excludes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
