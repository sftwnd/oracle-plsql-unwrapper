<?xml version="1.0" encoding="UTF-8"?>
<!-- The modules share the address of the project: Maven would append the name of a module to it -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.sftwnd</groupId>
    <artifactId>oracle-plsql-unwrapper-parent</artifactId>
    <version>1.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Oracle PL/SQL Unwrapper</name>
    <description>Libraries for restoring Oracle wrapped PL/SQL source code: the format SPI, the format V2 and the unwrapper</description>
    <url>https://github.com/sftwnd/oracle-plsql-unwrapper</url>

    <licenses>
        <license>
            <name>BSD-3-Clause</name>
            <url>https://opensource.org/license/bsd-3-clause</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>ashindarev</id>
            <name>Andrey Shindarev</name>
            <email>ashindarev@gmail.com</email>
            <timezone>Europe/Moscow</timezone>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <url>https://github.com/sftwnd/oracle-plsql-unwrapper</url>
        <connection>scm:git:https://github.com/sftwnd/oracle-plsql-unwrapper.git</connection>
        <developerConnection>scm:git:git@github.com:sftwnd/oracle-plsql-unwrapper.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>oracle-plsql-unwrap-spi</module>
        <module>oracle-plsql-unwrap-v2</module>
        <module>oracle-plsql-unwrapper</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- The code level of every module; JDK 9 and later compile it with release, see the profile java9-modules -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <jacoco-maven-plugin.version>0.8.16</jacoco-maven-plugin.version>
        <central-publishing-maven-plugin.version>0.12.0</central-publishing-maven-plugin.version>
        <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
        <maven-assembly-plugin.version>3.8.0</maven-assembly-plugin.version>
        <!-- the last one that runs on JDK 8: 6.x carries bnd 7, which needs JDK 17 -->
        <maven-bundle-plugin.version>5.1.9</maven-bundle-plugin.version>
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
        <maven-enforcer-plugin.version>3.7.0</maven-enforcer-plugin.version>
        <maven-failsafe-plugin.version>3.6.1</maven-failsafe-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-site-plugin.version>3.22.0</maven-site-plugin.version>
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>
        <junit.version>5.14.4</junit.version>
        <!-- the passphrase of the signing key comes from gpg-agent, not from a server of the settings -->
        <gpg.bestPractices>true</gpg.bestPractices>
        <!-- set to true by a project that must never be published: the profile release then uploads nothing -->
        <central.skip>false</central.skip>
        <!-- set to false by a module that builds an unwrapper: the profiles native and native-linux build only there -->
        <native.skip>true</native.skip>
        <!-- native-image of the JDK that runs Maven; another one with -Dnative.image.command=... -->
        <native.image.command>${java.home}/bin/native-image</native.image.command>
        <native.linux.image>ghcr.io/graalvm/native-image-community:25</native.linux.image>
        <!-- the native executable that the launch tests start: set by the profile native -->
        <native.executable/>
        <!-- the name of the bundle and of the JPMS module: each module sets its own -->
        <module.name/>
        <executable.jar.descriptor>${project.basedir}/src/assembly/executable-jar.xml</executable.jar.descriptor>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- The parent directory of a module is the root of its project, so a jar holds the license of its project -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/..</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                </includes>
            </resource>
        </resources>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <!-- SonarCloud analysis in the GitHub Actions workflow -->
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
                <!-- The plugins of the lifecycle that the project does not configure: their versions stay the same for any Maven -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>${maven-site-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <!-- A test starts the unwrapper in its own JVM, the test itself stays on the class path -->
                        <useModulePath>false</useModulePath>
                        <systemPropertyVariables>
                            <distribution.directory>${project.build.directory}/${project.build.finalName}-dist/unwrapper</distribution.directory>
                            <modules.directory>${project.build.directory}/${project.build.finalName}-modules</modules.directory>
                            <unwrapper.jar>${project.build.finalName}.jar</unwrapper.jar>
                            <executable.jar>${project.build.directory}/${project.build.finalName}-all.jar</executable.jar>
                            <native.executable>${native.executable}</native.executable>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                    <configuration>
                        <archive>
                            <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
                        </archive>
                    </configuration>
                </plugin>
                <!--
                    An unwrapper gets an executable jar next to its ordinary jar, which runs on the class path of any
                    JDK, and a distribution of that jar with bin/ from the jar of the unwrapper. The ordinary jars of its
                    modules stay in a directory of target, for the module path of the launch tests and for jlink.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>${maven-assembly-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>executable-jar</id>
                            <phase>package</phase>
                            <goals>
                                <goal>single</goal>
                            </goals>
                            <configuration>
                                <archive>
                                    <manifest>
                                        <mainClass>com.github.sftwnd.oracle.unwrap.cli.UnwrapperCli</mainClass>
                                    </manifest>
                                </archive>
                                <descriptors>
                                    <descriptor>${executable.jar.descriptor}</descriptor>
                                </descriptors>
                            </configuration>
                        </execution>
                        <execution>
                            <id>modules</id>
                            <phase>package</phase>
                            <goals>
                                <goal>single</goal>
                            </goals>
                            <configuration>
                                <attach>false</attach>
                                <inlineDescriptors>
                                    <inlineDescriptor>
                                        <id>modules</id>
                                        <formats>
                                            <format>dir</format>
                                        </formats>
                                        <includeBaseDirectory>false</includeBaseDirectory>
                                        <dependencySets>
                                            <dependencySet>
                                                <outputDirectory>.</outputDirectory>
                                                <useProjectArtifact>true</useProjectArtifact>
                                                <scope>runtime</scope>
                                            </dependencySet>
                                        </dependencySets>
                                    </inlineDescriptor>
                                </inlineDescriptors>
                            </configuration>
                        </execution>
                        <execution>
                            <id>distribution</id>
                            <phase>package</phase>
                            <goals>
                                <goal>single</goal>
                            </goals>
                            <configuration>
                                <!-- It goes out as a file: a directory cannot be an artifact, and the jars already are -->
                                <attach>false</attach>
                                <inlineDescriptors>
                                    <inlineDescriptor>
                                        <id>dist</id>
                                        <formats>
                                            <format>dir</format>
                                            <format>zip</format>
                                        </formats>
                                        <baseDirectory>unwrapper</baseDirectory>
                                        <files>
                                            <file>
                                                <source>${project.basedir}/../LICENSE</source>
                                            </file>
                                            <file>
                                                <source>${project.build.directory}/${project.build.finalName}-all.jar</source>
                                                <destName>${project.build.finalName}.jar</destName>
                                            </file>
                                        </files>
                                        <dependencySets>
                                            <dependencySet>
                                                <outputDirectory>.</outputDirectory>
                                                <useProjectArtifact>true</useProjectArtifact>
                                                <includes>
                                                    <include>com.github.sftwnd:oracle-plsql-unwrapper</include>
                                                </includes>
                                                <unpack>true</unpack>
                                                <unpackOptions>
                                                    <includes>
                                                        <include>bin/**</include>
                                                    </includes>
                                                </unpackOptions>
                                                <fileMode>0755</fileMode>
                                                <scope>runtime</scope>
                                            </dependencySet>
                                        </dependencySets>
                                    </inlineDescriptor>
                                </inlineDescriptors>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven-source-plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven-javadoc-plugin.version}</version>
                <configuration>
                    <source>8</source>
                    <!--
                        A broken reference, bad markup or a member without a comment fails the build. The comments are
                        sentences, without a tag for each parameter and result: doclint does not ask for the tags.
                    -->
                    <doclint>all,-missing</doclint>
                    <failOnWarnings>true</failOnWarnings>
                    <!-- the command line is no API -->
                    <excludePackageNames>com.github.sftwnd.oracle.unwrap.cli</excludePackageNames>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                OSGi headers; module.name is the name of the bundle and of the JPMS module. Each module adds its
                packages and capabilities to the instructions. The manifest is built before module-info.class appears:
                bnd takes the required execution environment from the class versions, and that stays Java 8.
            -->
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <version>${maven-bundle-plugin.version}</version>
                <executions>
                    <execution>
                        <id>bundle-manifest</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>manifest</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>${module.name}</Bundle-SymbolicName>
                        <Automatic-Module-Name>${module.name}</Automatic-Module-Name>
                        <Multi-Release>true</Multi-Release>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Native executable of an unwrapper for the system of the build, from its executable jar: target/native/unwrapper.
            It needs a GraalVM with native-image; the options of the image come from META-INF/native-image of the jars.
            Only a module with native.skip=false builds it.
        -->
        <profile>
            <id>native</id>
            <properties>
                <native.executable>${project.build.directory}/native/unwrapper</native.executable>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>native-image</id>
                                <!-- after the executable jar of the module, before the launch tests that start the image -->
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${native.skip}</skip>
                                    <executable>${native.image.command}</executable>
                                    <!-- native-image does not create the directory of the image, exec does -->
                                    <workingDirectory>${project.build.directory}/native</workingDirectory>
                                    <arguments>
                                        <argument>--no-fallback</argument>
                                        <argument>-jar</argument>
                                        <argument>${project.build.directory}/${project.build.finalName}-all.jar</argument>
                                        <argument>-o</argument>
                                        <argument>unwrapper</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            Native executable of an unwrapper for Linux x86_64, built in a container of GraalVM:
            target/native-linux-x64/unwrapper. It needs Docker; the executable needs glibc 2.34 or later.
        -->
        <profile>
            <id>native-linux</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>native-image-linux</id>
                                <!-- after the executable jar of the module, before the launch tests that start the image -->
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${native.skip}</skip>
                                    <executable>docker</executable>
                                    <workingDirectory>${project.build.directory}/native-linux-x64</workingDirectory>
                                    <arguments>
                                        <argument>run</argument>
                                        <argument>--rm</argument>
                                        <argument>--platform</argument>
                                        <argument>linux/amd64</argument>
                                        <argument>-v</argument>
                                        <argument>${project.build.directory}:/work</argument>
                                        <argument>-w</argument>
                                        <argument>/work/native-linux-x64</argument>
                                        <argument>${native.linux.image}</argument>
                                        <argument>--no-fallback</argument>
                                        <argument>-jar</argument>
                                        <argument>../${project.build.finalName}-all.jar</argument>
                                        <argument>-o</argument>
                                        <argument>unwrapper</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- native-image of GraalVM for Windows is a command file -->
        <profile>
            <id>native-image-windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <native.image.command>${java.home}/bin/native-image.cmd</native.image.command>
            </properties>
        </profile>
        <!--
            Release to Maven Central: ./mvnw -Prelease clean deploy on JDK 9 or later, with the signing key unlocked in
            gpg-agent. The deployment waits in the Central Publisher Portal as validated until it is published there by
            hand. A project with central.skip=true uploads nothing.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <!--
                            Only a release version of a published project, built on JDK 9 or later: a jar of JDK 8 has
                            no module descriptor, and central-publishing uploads a SNAPSHOT even with skipPublishing
                        -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>${maven-enforcer-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>release-on-jdk9+</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireReleaseVersion>
                                            <message>Only a release version is uploaded to Maven Central</message>
                                        </requireReleaseVersion>
                                        <requireProperty>
                                            <property>central.skip</property>
                                            <regex>false</regex>
                                            <regexMessage>This project is not published to Maven Central</regexMessage>
                                        </requireProperty>
                                        <requireJavaVersion>
                                            <version>[9,)</version>
                                            <message>A release has to be built on JDK 9 or later, so that the jars contain the module descriptors</message>
                                        </requireJavaVersion>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!-- deploy uploads to the Central Publisher Portal: server central of .mvn/settings.xml -->
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <deploymentName>oracle-plsql-unwrapper-${project.version}</deploymentName>
                            <skipPublishing>${central.skip}</skipPublishing>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            Coverage of the tests, for the analysis of the workflow. It is a profile so that an ordinary build stays as it
            is. Each module records its tests, and the unwrapper, which depends on all the others, makes one report: the
            classes of a module are also tested from the modules that use it.
        -->
        <profile>
            <id>coverage</id>
            <properties>
                <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/oracle-plsql-unwrapper/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            JDK 9 and later add the JPMS descriptor from src/main/java9 to the jar, as META-INF/versions/9, so that the
            classes stay at the level of Java 8 and JDK 8 does not see the descriptor. It is compiled after the tests
            and after the classes of the module, when the jars of the modules it requires exist: the descriptor of a
            multi-release jar is not found in target/classes.
        -->
        <profile>
            <id>java9-modules</id>
            <activation>
                <jdk>[9,)</jdk>
            </activation>
            <properties>
                <maven.compiler.release>8</maven.compiler.release>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>compile-module-info</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>compile</goal>
                                </goals>
                                <configuration>
                                    <release>9</release>
                                    <!-- the plugin itself patches the module with the classes of target/classes -->
                                    <multiReleaseOutput>true</multiReleaseOutput>
                                    <compileSourceRoots>
                                        <compileSourceRoot>${project.basedir}/src/main/java9</compileSourceRoot>
                                    </compileSourceRoots>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
